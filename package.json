{
  "name": "texbea",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "build:demo": "vite build --mode demo",
    "test": "node --test \"test/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.86",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.53.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.3",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
